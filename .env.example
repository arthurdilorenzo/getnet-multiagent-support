# ==============================================================================
# Getnet Multi-Agent Support System v2.0 - Environment Configuration Template
# Copy this file to `.env` for local development (`cp .env.example .env`)
# ==============================================================================

# 1. Google Gemini API (Optional: enables native LLM Function Calling & Synthesis)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# 2. Security, Authentication & Rate Limiting
# Leave blank only for the local demo (ephemeral credentials, no verified merchant identity).
# For production, independently generate BOTH secrets with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
AUTH_API_KEY=""
JWT_SECRET=""
# Production and any configured/issued/verified JWT force strict authentication.
AUTH_ENFORCE_STRICT="false"
RATE_LIMIT_PER_MINUTE="60"
ALLOWED_ORIGINS='["http://localhost:8000","http://127.0.0.1:8000"]'

# 3. Hybrid RAG & Orchestration Parameters
RAG_TOP_K="3"
RAG_MIN_RELEVANCE_THRESHOLD="0.26"
MAX_ORCHESTRATION_ITERATIONS="4"
MAX_TOOL_TURNS="3"
MEMORY_WINDOW_MESSAGES="10"

# 4. Resilience, Timeouts & Circuit Breakers
HTTP_TIMEOUT_SECONDS="4.0"
LLM_TIMEOUT_SECONDS="30.0"
REQUEST_TIMEOUT_SECONDS="60.0"
HTTP_MAX_RETRIES="2"
CB_FAILURE_THRESHOLD="3"
CB_RECOVERY_TIMEOUT_SECONDS="30.0"
TOOL_TIMEOUT_SECONDS="5.0"

# 5. Human-in-the-Loop (HITL) External Notification Channels (Optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
HITL_WEBHOOK_URL=""

# 6. Server Runtime
APP_ENV="development"
LOG_LEVEL="INFO"
APP_HOST="0.0.0.0"
APP_PORT="8000"
