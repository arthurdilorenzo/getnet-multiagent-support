# ==============================================================================
# Getnet Multi-Agent Support System v2.0 - Environment Configuration Template
# Copy this file to `.env` for local development (`cp .env.example .env`)
# ==============================================================================

# 1. Google Gemini API (Optional: enables native LLM Function Calling & Synthesis)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# 2. Security, Authentication & Rate Limiting
AUTH_API_KEY="getnet-dev-api-key-2026"
JWT_SECRET="getnet-hmac-sha256-secret-key-2026-prod"
AUTH_ENFORCE_STRICT="false"
RATE_LIMIT_PER_MINUTE="60"
ALLOWED_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"

# 3. Hybrid RAG & Orchestration Parameters
RAG_TOP_K="3"
RAG_MIN_RELEVANCE_THRESHOLD="0.26"
MAX_SUPERVISOR_ITERATIONS="4"
MAX_TOOL_TURNS="3"
MEMORY_WINDOW_MESSAGES="10"

# 4. Resilience, Timeouts & Circuit Breakers
HTTP_TIMEOUT_SECONDS="4.0"
HTTP_MAX_RETRIES="2"
CB_FAILURE_THRESHOLD="3"
CB_RECOVERY_TIMEOUT_SECONDS="30.0"
TOOL_TIMEOUT_SECONDS="5.0"

# 5. Human-in-the-Loop (HITL) External Notification Channels (Optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
HITL_WEBHOOK_URL=""

# 6. Server Runtime
APP_ENV="production"
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT="8000"
