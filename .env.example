# ==============================================================================
# Getnet Multi-Agent Support System - Environment Configuration
# ==============================================================================

# Google Gemini API Key (Required for live LLM inference)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection (defaults to gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Application Settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# Optional: Web Search Engine (built-in live fallback included for Weather/FX)
TAVILY_API_KEY=
